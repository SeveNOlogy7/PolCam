 {
  "context": "ImageDisplay",
  "source": "· 连接相机：左侧顶部的按钮，未连接时写“连接相机”，已连接时写“断开相机”",
  "translation": "· Connect: the button at the top left reads “Connect Camera” when idle and “Disconnect Camera” when connected"
 },
 {
  "context": "ImageDisplay",
  "source": "· 调节图像：使用曝光和增益控制",
  "translation": "· Adjust the image with the exposure and gain controls"
 },
 {
  "context": "ImageDisplay",
  "source": "· 采集图像：“单帧采集”，或“连续采集”（采集进行中那个按钮写成“停止采集”）",
  "translation": "· Capture: “Single Frame”, or “Continuous Capture” (that button reads “Stop Capture” while running)"
 },
 {
  "context": "ImageDisplay",
  "source": "· 显示模式：在顶部下拉框切换显示方式",
  "translation": "· Display mode: switch it in the drop-down at the top"
 },
 {
  "context": "ImageDisplay",
  "source": "· 游标：查看图像像素信息",
  "translation": "· Cursor: read pixel values off the image"
 },
 {
  "context": "ImageDisplay",
  "source": "· 缩放：放大、缩小，或框选区域放大",
  "translation": "· Zoom: in, out, or drag a box to zoom into"
 },
 {
  "context": "ImageDisplay",
  "source": "· 复原：恢复原始显示",
  "translation": "· Reset: back to the full view"
 },
 {
  "context": "ImageDisplay",
  "source": "· 白平衡：彩色模式下可开启自动白平衡",
  "translation": "· White balance: automatic white balance is available in the colour modes"
 },
 {
  "context": "ImageDisplay",
  "source": "· 偏振分析：查看 DOLP、AOLP 等偏振信息",
